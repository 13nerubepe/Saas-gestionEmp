# One site: the Angular app and the API share the same origin, so the refresh
# cookie works without cross-site settings and no CORS is needed.
# Caddy gets and renews the HTTPS certificate for {$APP_DOMAIN} by itself.

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Django: API, admin, and the admin/API static files (served by WhiteNoise).
	@django path /api/* /admin/* /static/*
	handle @django {
		reverse_proxy api:8000
	}

	# Angular: real files first, otherwise index.html (client-side routes).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Hashed bundles never change: cache them for a year; index.html is not cached.
	@hashed path_regexp \.[0-9A-Za-z]{16,}\.(js|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@index path / /index.html
	header @index Cache-Control "no-cache"
}
