# Copy to .env and adjust. .env is never committed.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Matches the "db" service of docker-compose.yml, reached from the host.
DATABASE_URL=postgres://app:app@localhost:5434/app

# Angular dev server
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Refresh-token cookie. Local HTTP needs False; production keeps the default True.
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax

# AI provider. Free-tier key from https://aistudio.google.com/ (fictitious data only).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
