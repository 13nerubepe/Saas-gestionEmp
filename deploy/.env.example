# Copy to deploy/.env ON THE SERVER and fill in. Never commit deploy/.env.
# Docker Compose reads it for ${...} in docker-compose.prod.yml, and the api
# service receives every variable as its environment.

# Public host name. Without a domain, use the server IP with sslip.io:
# IP 13.37.42.1 -> 13-37-42-1.sslip.io (HTTPS certificate included).
APP_DOMAIN=13-37-42-1.sslip.io

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Database (internal to the server, never exposed).
POSTGRES_DB=app
POSTGRES_USER=app
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# AI provider.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Refresh-token cookie: HTTPS only, same site as the app.
REFRESH_COOKIE_SECURE=True
REFRESH_COOKIE_SAMESITE=Lax

LOG_LEVEL=WARNING
